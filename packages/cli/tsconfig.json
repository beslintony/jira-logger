{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "paths": {
      "@jira-logger/config": ["../config/dist"],
      "@jira-logger/core": ["../core/dist"],
      "@jira-logger/jira-api": ["../jira-api/dist"],
      "@jira-logger/parsers": ["../parsers/dist"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "tests"],
  "references": [
    { "path": "../config" },
    { "path": "../core" },
    { "path": "../jira-api" },
    { "path": "../parsers" }
  ]
}
