{
  "name": "@jira-logger/core",
  "version": "2.0.0",
  "description": "Core business logic for Jira Time Logger",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jira-logger/config": "workspace:*",
    "@jira-logger/jira-api": "workspace:*",
    "@jira-logger/parsers": "workspace:*",
    "fuse.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
