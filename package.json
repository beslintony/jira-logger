{
  "name": "jira-time-logger",
  "version": "1.1.0",
  "description": "A CLI tool to log time to Jira from Grindstone time tracking files",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "jira-time-logger": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "jira",
    "time",
    "tracking",
    "logging",
    "cli",
    "grindstone"
  ],
  "author": "beslintony@gmail.com",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "inquirer": "^8.2.5"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.6",
    "@types/jest": "^29.5.6",
    "@types/node": "^20.8.7",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}